{
  "name": "open-duck-mini-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "Static, client-side browser GUI for the Open Duck Mini V2 bipedal duck robot — URDF viewer, motion library, pose editor, deployable to GitHub Pages.",
  "license": "Apache-2.0",
  "author": "Masato Kobayashi (mertcookimg)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mertcookimg/Open_Duck_Mini_Viewer.git"
  },
  "homepage": "https://mertcookimg.github.io/Open_Duck_Mini_Viewer/",
  "keywords": [
    "robotics",
    "urdf",
    "open-duck-mini",
    "three-js",
    "react",
    "vite",
    "static-site"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "urdf-loader": "^0.12.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
